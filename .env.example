# Copy to .env, insert your local API key, then export these variables.
# .env is not loaded automatically; see README for shell instructions.
# Use a per-indexer Torznab endpoint, NOT Prowlarr's web root.
TORZNAB_URL=http://localhost:9696/1/api
TORZNAB_API_KEY=
TORZNAB_NAME=prowlarr
CONNECT_TIMEOUT=5
READ_TIMEOUT=10
PROVIDER_TIMEOUT=20
MAX_CONCURRENCY=4
RESOLUTION_ORDER=2160p,1080p,720p,480p
PREFERRED_LANGUAGES=es,es-419,en
# Empty means no maximum; this limit also applies to cached candidates.
MAX_SIZE_BYTES=
MIN_SEEDERS=0

# Native Stremio addon server. Set HTTP_HOST=0.0.0.0 for explicit LAN access.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Optional advertised base URL, used for the CLI installation address only.
# PUBLIC_ADDON_URL=https://addon.example.invalid

# Optional JSON file of 1–16 indexers. Replaces TORZNAB_URL when set.
# Copy providers.example.json locally; keys are read from referenced env vars.
# PROVIDERS_FILE=providers.json
# PROWLARR_API_KEY=

# Optional: sends requested IMDb IDs/media types to Cinemeta ONLY when a title
# is needed for discovery (doctor also performs an explicit metadata check).
CINEMETA_ENABLED=false
METADATA_CONNECT_TIMEOUT=3
METADATA_READ_TIMEOUT=5
METADATA_TTL=3600
METADATA_NEGATIVE_TTL=30
METADATA_CACHE_ENTRIES=256

# Discovery-result caching, NOT downloaded media/debrid caching. TTL=0 disables
# retained results but concurrent identical requests still share active work.
DISCOVERY_CACHE_TTL=30
DISCOVERY_CACHE_ENTRIES=128
DISCOVERY_CACHE_BYTES=8388608
DISCOVERY_MAX_INFLIGHT=32

# Optional Phase 3A backend LIBRARY settings. These do not enable downloads in
# search/serve/doctor and add no HTTP playback or preparation endpoint.
# qBittorrent 4.6/5.x Web UI, private binding only. Example uses 8081 to avoid the
# addon on 8080; the adapter's unset default is http://127.0.0.1:8080.
QBITTORRENT_URL=http://127.0.0.1:8081
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# Absolute, shared local path, identical in qBittorrent and Self-Debrid.
TORRENT_DOWNLOAD_DIRECTORY=/srv/self-debrid/downloads
# Empty denies HTTP torrent retrieval. Explicit trusted HTTP(S) origins only;
# no paths or secrets. Redirects are rejected. Does not affect magnets.
TORRENT_DOWNLOAD_ORIGINS=
# Example: TORRENT_DOWNLOAD_ORIGINS=http://127.0.0.1:9696,https://indexer.example.invalid
TORRENT_CONNECT_TIMEOUT=5
TORRENT_READ_TIMEOUT=10
TORRENT_REQUEST_TIMEOUT=20
TORRENT_METADATA_TIMEOUT=60
TORRENT_PREPARATION_TIMEOUT=120
TORRENT_POLL_INTERVAL=0.5
TORRENT_MAX_SESSIONS=4
TORRENT_MAX_RECORDS=32
TORRENT_SESSION_TTL=3600
TORRENT_SEQUENTIAL=true
TORRENT_FIRST_LAST=true
